<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion</title>
    <link rel="stylesheet" href="/css/login.css"> <!-- Assurez-vous du chemin vers le CSS -->
</head>

<body>
    <!-- Conteneur principal du formulaire de connexion -->
    <div class="login-form">
        <!-- Logo placé ici -->
        <img src="/images/logo_amp.jpg" alt="Logo de l'entreprise" class="logo">
        <form>
            <label for="email">Email :</label>
            <input type="email" id="email" name="email" required>

            <label for="mot_de_passe">Password :</label>
            <input type="password" id="mot_de_passe" name="mot_de_passe" required>

            <button type="submit">login</button>
        </form>
        <!-- Charger le script JavaScript pour gérer la soumission -->
    <script src="/js/login.js"></script>
    </div>
</body>

</html>