<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion</title>
    <link rel="stylesheet" href="/css/login.css"> <!-- Assurez-vous du chemin vers le CSS -->
</head>

<body>
    <!-- Conteneur principal du formulaire de connexion -->
    <div class="login-form">
        <!-- Logo placé ici -->
        <img src="/images/logo_amp.jpg" alt="Logo de l'entreprise" class="logo">
        <form>
            <label for="email">Email :</label>
            <input type="email" id="email" name="email" required>

            <label for="mot_de_passe">Password :</label>
            <div class="password-container">
                <input type="password" id="mot_de_passe" name="mot_de_passe" required>
                <a href="#" class="toggle-password" id="togglePassword">
                    <!-- SVG pour l'icône de l'œil ouvert -->
                    <svg id="eyeOpen" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 4.5C7.30558 4.5 3.22183 7.30375 1.5 12C3.22183 16.6962 7.30558 19.5 12 19.5C16.6944 19.5 20.7782 16.6962 22.5 12C20.7782 7.30375 16.6944 4.5 12 4.5ZM12 17.25C8.82436 17.25 6.25 14.6756 6.25 11.5C6.25 8.32436 8.82436 5.75 12 5.75C15.1756 5.75 17.75 8.32436 17.75 11.5C17.75 14.6756 15.1756 17.25 12 17.25ZM12 7.5C10.2051 7.5 8.75 8.95507 8.75 10.75C8.75 12.5449 10.2051 14 12 14C13.7949 14 15.25 12.5449 15.25 10.75C15.25 8.95507 13.7949 7.5 12 7.5Z" fill="#000"/>
                    </svg>
                    <!-- SVG pour l'icône de l'œil barré -->
                    <svg id="eyeClosed" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: none;">
                        <path d="M12 4.5C7.30558 4.5 3.22183 7.30375 1.5 12C3.22183 16.6962 7.30558 19.5 12 19.5C16.6944 19.5 20.7782 16.6962 22.5 12C20.7782 7.30375 16.6944 4.5 12 4.5ZM12 17.25C8.82436 17.25 6.25 14.6756 6.25 11.5C6.25 8.32436 8.82436 5.75 12 5.75C15.1756 5.75 17.75 8.32436 17.75 11.5C17.75 14.6756 15.1756 17.25 12 17.25ZM12 7.5C10.2051 7.5 8.75 8.95507 8.75 10.75C8.75 12.5449 10.2051 14 12 14C13.7949 14 15.25 12.5449 15.25 10.75C15.25 8.95507 13.7949 7.5 12 7.5Z" fill="#000"/>
                        <line x1="2" y1="2" x2="22" y2="22" stroke="#000" stroke-width="2"/>
                    </svg>
                </a>
            </div>

            <button type="submit">login</button>
        </form>
    </div>
    <!-- Charger le script JavaScript pour gérer la soumission -->
    <script src="/js/login.js"></script>
</body>

</html>