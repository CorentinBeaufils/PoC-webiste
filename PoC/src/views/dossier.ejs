<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ajouter un Dossier</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/navbar.css"> <!-- Charger uniquement les styles de la navbar -->
</head>

<body>
    <!-- Inclure la barre de navigation -->
    <%- include('partials/navbar') %> 

    <div class="container">
        <h2>Ajouter un Dossier</h2>
        <form id="dossierForm">
            <input type="text" id="nom" placeholder="Nom du dossier" required><br>
            <textarea id="description" placeholder="Description" required></textarea><br>
            <button type="submit">Créer Dossier</button>
        </form>

        <p id="errorMessage"></p>
    </div>

    <script src="/js/dossier.js"></script>
</body>

</html>