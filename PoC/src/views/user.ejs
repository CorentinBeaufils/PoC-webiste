<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil Utilisateur</title>
    <link rel="stylesheet" href="/css/user.css">
    <link rel="stylesheet" href="/css/navbar.css"> <!-- Inclure les styles de la barre de navigation -->
</head>
<body>
    <!-- Barre de navigation -->
    <%- include('partials/navbar') %> <!-- Inclure la barre de navigation -->

    <div class="container">
        <h2>Welcome, <%= user.email %>!</h2>

            <!-- Actions administrateur, affichées uniquement pour les administrateurs -->
            <div id="adminActions">
                <h3>Admin Pannel</h3>

                <!-- Formulaire pour créer un utilisateur -->
                <form id="createUserForm">
                    <h4>Create user</h4>
                    <input type="text" id="nom" placeholder="Name" required>
                    <input type="email" id="email" placeholder="Email" required>
                    <div class="password-container">
                        <input type="password" id="mot_de_passe" name="mot_de_passe" placeholder="Password" required>
                        <a href="#" class="toggle-password" id="togglePassword">
                            <!-- SVG pour l'icône de l'œil ouvert -->
                            <svg id="eyeOpen" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 4.5C7.30558 4.5 3.22183 7.30375 1.5 12C3.22183 16.6962 7.30558 19.5 12 19.5C16.6944 19.5 20.7782 16.6962 22.5 12C20.7782 7.30375 16.6944 4.5 12 4.5ZM12 17.25C8.82436 17.25 6.25 14.6756 6.25 11.5C6.25 8.32436 8.82436 5.75 12 5.75C15.1756 5.75 17.75 8.32436 17.75 11.5C17.75 14.6756 15.1756 17.25 12 17.25ZM12 7.5C10.2051 7.5 8.75 8.95507 8.75 10.75C8.75 12.5449 10.2051 14 12 14C13.7949 14 15.25 12.5449 15.25 10.75C15.25 8.95507 13.7949 7.5 12 7.5Z" fill="#000"/>
                            </svg>
                            <!-- SVG pour l'icône de l'œil barré -->
                            <svg id="eyeClosed" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: none;">
                                <path d="M12 4.5C7.30558 4.5 3.22183 7.30375 1.5 12C3.22183 16.6962 7.30558 19.5 12 19.5C16.6944 19.5 20.7782 16.6962 22.5 12C20.7782 7.30375 16.6944 4.5 12 4.5ZM12 17.25C8.82436 17.25 6.25 14.6756 6.25 11.5C6.25 8.32436 8.82436 5.75 12 5.75C15.1756 5.75 17.75 8.32436 17.75 11.5C17.75 14.6756 15.1756 17.25 12 17.25ZM12 7.5C10.2051 7.5 8.75 8.95507 8.75 10.75C8.75 12.5449 10.2051 14 12 14C13.7949 14 15.25 12.5449 15.25 10.75C15.25 8.95507 13.7949 7.5 12 7.5Z" fill="#000"/>
                                <line x1="2" y1="2" x2="22" y2="22" stroke="#000" stroke-width="2"/>
                            </svg>
                        </a>
                    </div>
                    <select id="role">
                        <option value="user">User</option>
                        <option value="admin">Admin</option>
                    </select>
                    <button type="submit" class="userBtn">Create User</button>
                    <p id="createMessage"></p>
                </form>

                <!-- Div pour afficher les utilisateurs -->
                <div id="userList">
                    <h3>User List</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="users">
                            <!-- Les utilisateurs seront ajoutés ici dynamiquement -->
                        </tbody>
                    </table>
                </div>
            </div>
    </div>

    <!-- Modal pour modifier un utilisateur -->
    <div id="editUserModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal()">&times;</span>
            <h3>Modify User</h3>
            <form id="editUserForm">
                <input type="hidden" id="editEmail">
                <label for="editNom">Name:</label>
                <input type="text" id="editNom" required>
                <label for="editNewEmail">Email:</label>
                <input type="email" id="editNewEmail" required>
                <label for="editRole">Role:</label>
                <select id="editRole">
                    <option value="user">User</option>
                    <option value="admin">Admin</option>
                </select>
                <button type="submit" class="userBtn">Update User</button>
            </form>
        </div>
    </div>

    <!-- Charger le fichier JavaScript séparé pour le profil utilisateur -->
    <script src="/js/user.js"></script>
</body>
</html>