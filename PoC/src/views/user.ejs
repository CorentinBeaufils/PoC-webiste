<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil Utilisateur</title>
    <link rel="stylesheet" href="/css/user.css">
    <link rel="stylesheet" href="/css/navbar.css"> <!-- Inclure les styles de la barre de navigation -->
</head>
<body>
    <!-- Barre de navigation -->
    <%- include('partials/navbar') %> <!-- Inclure la barre de navigation -->

    <div class="container">
        <h2>Welcome, <%= user.email %>!</h2>

            <!-- Actions administrateur, affichées uniquement pour les administrateurs -->
            <div id="adminActions">
                <h3>Admin Pannel</h3>

                <!-- Formulaire pour créer un utilisateur -->
                <form id="createUserForm">
                    <h4>Create user</h4>
                    <input type="text" id="nom" placeholder="Nom" required>
                    <input type="email" id="email" placeholder="Email" required>
                    <input type="password" id="mot_de_passe" placeholder="Mot de passe" required>
                    <select id="role">
                        <option value="user">User</option>
                        <option value="admin">Admin</option>
                    </select>
                    <button type="submit" class="userBtn">Create User</button>
                    <p id="createMessage"></p>
                </form>

                <!-- Div pour afficher les utilisateurs -->
                <div id="userList">
                    <h3>User List</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="users">
                            <!-- Les utilisateurs seront ajoutés ici dynamiquement -->
                        </tbody>
                    </table>
                </div>
            </div>
    </div>

    <!-- Modal pour modifier un utilisateur -->
    <div id="editUserModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal()">&times;</span>
            <h3>Modify User</h3>
            <form id="editUserForm">
                <input type="hidden" id="editEmail">
                <label for="editNom">Name:</label>
                <input type="text" id="editNom" required>
                <label for="editNewEmail">Email:</label>
                <input type="email" id="editNewEmail" required>
                <label for="editRole">Role:</label>
                <select id="editRole">
                    <option value="user">User</option>
                    <option value="admin">Admin</option>
                </select>
                <button type="submit" class="userBtn">Update User</button>
            </form>
        </div>
    </div>

    <!-- Charger le fichier JavaScript séparé pour le profil utilisateur -->
    <script src="/js/user.js"></script>
</body>
</html>