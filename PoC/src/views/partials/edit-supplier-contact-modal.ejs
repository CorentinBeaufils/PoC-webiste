<div id="editContactModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeModal('editContactModal')">&times;</span>
        <h3>Edit Contact</h3>
        <div id="separator"></div>
        <form id="contactForm" action="/api/supplier-contacts" method="POST">
            <input type="hidden" id="contact_id" name="contact_id">
            <label for="contact_name">Name:</label>
            <input type="text" id="contact_name" name="name">
            <label for="contact_mobile">Mobile:</label>
            <input type="text" id="contact_mobile" name="mobile">
            <label for="contact_email">Email:</label>
            <input type="text" id="contact_email" name="email">
            <button type="submit">Save Changes</button>
        </form>
    </div>
</div>