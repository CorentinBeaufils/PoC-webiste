<!-- Modal personnalisé pour les contacts -->
<div id="<%= modalId %>" class="custom-modal">
    <div class="custom-modal-content">
        <span class="custom-close" onclick="closeModal('<%= modalId %>')">&times;</span>
        <h2><%= modalTitle %></h2>
        <form id="<%= formId %>">
            <label>Contact Name :</label>
            <input type="text" name="name" required>

            <label>Position :</label>
            <input type="text" name="contact-function">

            <label>Mobile :</label>
            <input type="tel" name="mobile">

            <label>Email :</label>
            <input type="email" name="email">

            <label>Direct Phone :</label>
            <input type="tel" name="direct_phone">

            <button type="button" onclick="<%= saveFunction %>">Enregistrer</button>
            <button type="button" onclick="closeModal('<%= modalId %>')">Annuler</button>
        </form>
    </div>
</div>