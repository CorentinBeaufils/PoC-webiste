<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Clients</title>
    <link rel="stylesheet" href="/css/customer.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/modale.css">
    <script src="/js/customer.js" defer></script>

</head>

<body>
    <!-- Inclure la barre de navigation -->
    <%- include('partials/navbar') %>
        <!-- Menu de navigation pour basculer entre les sections -->
        <div class="customer-nav">
            <button onclick="showSection('createCustomer')" >Create Customer</button>
            <button onclick="showSection('viewCustomers')">Customer List</button>
            <button onclick="showSection('communications')">communications / notes</button>
            <button onclick="showSection('orders')">Orders</button>
        </div>

    <!-- Inclure le partial pour le modal d'édition d'adresse -->
    <%- include('partials/modal', { 
        modalId: 'editAddressModal', 
        modalTitle: 'Edit Address', 
        formId: 'editAddressForm', 
        saveFunction: 'saveAddress()', 
        disableType: true,
        type: 'main'
    }) %>

    <!-- Inclure le partial pour le modal d'ajout d'adresse -->
    <%- include('partials/modal', { 
        modalId: 'addAddressModal', 
        modalTitle: 'Add New Address', 
        formId: 'addAddressForm', 
        saveFunction: 'saveNewAddress()', 
        disableType: true,
        type: 'secondary'
    }) %>

    <!-- Inclure le partial pour le modal d'édition de contact -->
    <%- include('partials/modal_contact', { 
        modalId: 'editContactModal', 
        modalTitle: 'Edit Contact', 
        formId: 'editContactForm', 
        saveFunction: 'saveContact()'
    }) %>

    <!-- Inclure le partial pour le modal d'ajout de contact -->
    <%- include('partials/modal_contact', { 
        modalId: 'addContactModal', 
        modalTitle: 'Add New Contact', 
        formId: 'addContactForm', 
        saveFunction: 'saveNewContact()'
    }) %>

    <!-- Inclure le partial pour le modal d'édition de méthode de communication -->
    <%- include('partials/modal_communication_method', { 
        modalId: 'editCommunicationMethodModal', 
        modalTitle: 'Edit Communication Method', 
        formId: 'editCommunicationMethodForm', 
        saveFunction: 'saveCommunicationMethod()'
    }) %>

    <!-- Inclure le partial pour le modal d'ajout de méthode de communication -->
    <%- include('partials/modal_communication_method', { 
        modalId: 'addCommunicationMethodModal', 
        modalTitle: 'Add new Communication Method', 
        formId: 'addCommunicationMethodForm', 
        saveFunction: 'saveNewCommunicationMethod()'
    }) %>

        <!-- Section pour créer un client -->
        <section id="createCustomer" class="main-section customer-section" style="display: none;">
            <h2>Create Customer</h2>
            <form id="createCustomerForm">
                <label for="customerName">Customer Name :</label>
                <input type="text" id="customerName" name="name" required>
                <label for="customerName">Keywork :</label>
                <input type="text" id="customerKeyword" name="keyword" required>
                <button type="submit">Create Customer</button>
            </form>

            <!-- Conteneur pour le bouton de retour -->
            <div class="return-button-container">
                <button onclick="showSection('viewCustomers')">Customer List</button>
            </div>
        </section>

        <!-- Nouvelle section pour voir la liste des clients -->
        <section id="viewCustomers" class="main-section customer-section" style="display: block;">
            <div id="customerList">
                <h2>Customer List</h2>
                <div>
                    <select id="filterType">
                        <option value="name">Filter by name</option>
                        <option value="keyword">Filter by keyword</option>
                        <option value="contact">Filter by contact</option>
                    </select>
                    <input type="text" id="filterValue" placeholder="Enter filter value">
                    <button onclick="filterCustomers()">Filter</button>
                </div>
                <div id="customerContainer"></div> <!-- Conteneur pour la liste des clients -->
            </div>

            <!-- Section pour afficher les détails d'un client -->
            <section id="customerDetails" class="sub-section" style="display: none;">
                <h2>Customer Details</h2>
                <div id="detailsCustomerInfo" class="info-block"></div>

                <h3>Adresses</h3>
                <div class="header-container">
                    <div class="customer-detail-address header">
                        <div class="address-type"><strong>Type</strong></div>
                        <div class="address-elements"><strong>Adress</strong></div>
                        <div class="address-buttons"><strong>Action</strong></div>
                    </div>
                </div>
                <div id="detailsAddressesContainer" class="customer-grid"></div>
                <button onclick="addNewAddress()">Add New Address</button>

                <h3>Contacts</h3>
                <div class="header-container">
                    <div class="customer-detail-contact header">
                        <div class="contact-name"><strong>Name</strong></div>
                        <div class="contact-details"><strong>Details</strong></div>
                        <div class="contact-buttons"><strong>Action</strong></div>
                    </div>
                </div>
                <div id="detailsContactsContainer" class="customer-grid"></div>
                <button onclick="addNewContact()">Add a Contact</button>

                <h3>Communication Methods</h3>
                <div class="header-container">
                    <div class="customer-communication-method header">
                        <div class="communication-method-type"><strong>Type</strong></div>
                        <div class="communication-method-details"><strong>Details</strong></div>
                        <div class="communication-method-buttons"><strong>Action</strong></div>
                    </div>
                </div>
                <div id="detailsCommunicationMethodsContainer" class="customer-grid"></div>
                <button onclick="addNewCommunicationMethod()">Add a Communication Method</button>

                <!-- Conteneur pour le bouton de retour -->
                <div class="return-button-container">
                    <button onclick="showSection('viewCustomers')">Customer List</button>
                </div>
            </section>
        </section>

        <!-- Section pour les communications -->
        <section id="communications" class="main-section customer-section" style="display: none;">
            <h2>Communications / Notes</h2>
            <form id="communicationForm">
                <label for="communicationContent">Contenu de la Communication :</label>
                <textarea id="communicationContent" name="content" required></textarea>
                <button type="submit">Enregistrer la Communication</button>
            </form>
            <div id="communicationList"></div>
        </section>

        <!-- Section pour les commandes -->
        <section id="orders" class="main-section customer-section" style="display: none;">
            <h2>Commandes</h2>
            <p>Section réservée pour les commandes (non encore implémentée).</p>
        </section>

        <!-- Message d'erreur ou de succès -->
        <p id="message"></p>

  </body>

</html>