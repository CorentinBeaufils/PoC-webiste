<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liste des Dossiers</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/navbar.css"> <!-- Charger uniquement les styles de la navbar -->
</head>

<body>
    <!-- Inclure la barre de navigation -->
    <%- include('partials/navbar') %> 

    <div class="container">
        <h2>Liste des Dossiers</h2>
        <table id="dossierTable">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Date de Création</th>
                </tr>
            </thead>
            <tbody id="dossierList"></tbody>
        </table>

        <!-- Loader pour indiquer que les données se chargent -->
        <div id="loader">
            <p>Chargement...</p>
        </div>
    </div>

    <script src="/js/dossier_list.js"></script>
</body>

</html>